{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build + copy to game",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\build.ps1\"",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build + copy + start game",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\build.ps1\" -Run",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Watch (auto build + copy on save)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\watch.ps1\"",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
