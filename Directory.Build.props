<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Authors>DiceModders</Authors>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <!-- Game interop assemblies: symlink/junction <game>/BepInEx/interop to ./interop (see README). -->
    <Reference Include="$(MSBuildThisFileDirectory)interop/*.dll" Private="false" />
    <!-- Small helpers shared by every plugin; compiled into each assembly as internal types. -->
    <Compile Include="$(MSBuildThisFileDirectory)src/Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
